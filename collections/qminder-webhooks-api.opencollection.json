{
  "opencollection": "1.0.0",
  "info": {
    "name": "Qminder Appointments Webhooks API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-Qminder-REST-API-Key",
      "value": "{{X-Qminder-REST-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Webhooks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Adding a webhook",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.qminder.com/v1/webhooks",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Adding a webhook"
        },
        {
          "info": {
            "name": "Removing a webhook",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.qminder.com/v1/webhooks/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "ID of a webhook to delete"
              }
            ]
          },
          "docs": "Removing a webhook"
        }
      ]
    }
  ],
  "bundled": true
}