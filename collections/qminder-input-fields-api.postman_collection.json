          "id": "85ad057c-89a4-4e6a-b8f3-f2ff21aa6b95",
          "name": "Edit an input field",
          "request": {
            "name": "Edit an input field",
            "description": {
              "content": "Updates an existing input field. Only include fields you want to change — omitted fields remain unchanged. Set `visitorFacingTitle` to `null` to clear it.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "input-fields",
                ":inputFieldId"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<uuid>",
                  "key": "inputFieldId",
                  "description": "(Required) UUID of the input field to update."
                }
              ]
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) API version. Must be set to `2020-09-01`.",
                "key": "X-Qminder-API-Version",
                "value": "2020-09-01"
