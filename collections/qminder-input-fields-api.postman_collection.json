        {
          "id": "a918592a-7a78-49eb-929a-d01713104e99",
          "name": "Create an input field",
          "request": {
            "name": "Create an input field",
            "description": {
              "content": "Creates a new input field for a location. The client must generate a UUID for the input field ID. EMAIL and PHONE_NUMBER types are singletons — only one of each is allowed per location.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "input-fields"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) API version. Must be set to `2020-09-01`.",
                "key": "X-Qminder-API-Version",
                "value": "2020-09-01"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"<uuid>\",\n  \"location\": {\n    \"id\": \"<integer>\"\n  },\n  \"type\": \"<string>\",\n  \"isMandatoryBeforeAdded\": \"<boolean>\",\n  \"isMandatoryBeforeServed\": \"<boolean>\",\n  \"isMandatoryInRemoteSignIn\": \"<boolean>\",\n  \"isVisibleInWaitingDrawer\": \"<boolean>\",\n  \"isVisibleInServingDrawer\": \"<boolean>\",\n  \"showInRemoteSignIn\": \"<boolean>\",\n  \"visibleForLines\": [\n    {\n      \"id\": \"<integer>\"\n    },\n    {\n      \"id\": \"<integer>\"\n    }\n  ],\n  \"title\": \"<string>\",\n  \"visitorFacingTitle\": \"<string>\",\n  \"multiSelect\": \"<boolean>\",\n  \"options\": [\n    {\n      \"id\": \"<uuid>\",\n      \"title\": \"<string>\",\n      \"color\": \"<string>\"\n    },\n    {\n      \"id\": \"<uuid>\",\n      \"title\": \"<string>\",\n      \"color\": \"<string>\"\n    }\n  ],\n  \"constraints\": {\n    \"scale\": \"<integer>\",\n    \"min\": \"<number>\",\n    \"max\": \"<number>\"\n  },\n  \"translations\": [\n    {\n      \"languageCode\": \"<string>\",\n      \"title\": \"<string>\",\n      \"visitorFacingTitle\": \"<string>\"\n    },\n    {\n      \"languageCode\": \"<string>\",\n      \"title\": \"<string>\",\n      \"visitorFacingTitle\": \"<string>\"\n    }\n  ],\n  \"isRequiredInAppointments\": \"<boolean>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
