            ],
            "method": "PATCH",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"<string>\",\n  \"visitorFacingTitle\": \"<string>\",\n  \"isVisibleInWaitingDrawer\": \"<boolean>\",\n  \"isVisibleInServingDrawer\": \"<boolean>\",\n  \"isMandatoryBeforeAdded\": \"<boolean>\",\n  \"isMandatoryBeforeServed\": \"<boolean>\",\n  \"isMandatoryInRemoteSignIn\": \"<boolean>\",\n  \"showInRemoteSignIn\": \"<boolean>\",\n  \"visibleForLines\": [\n    {\n      \"id\": \"<integer>\"\n    },\n    {\n      \"id\": \"<integer>\"\n    }\n  ],\n  \"multiSelect\": \"<boolean>\",\n  \"options\": [\n    {\n      \"id\": \"<uuid>\",\n      \"title\": \"<string>\",\n      \"color\": \"<string>\"\n    },\n    {\n      \"id\": \"<uuid>\",\n      \"title\": \"<string>\",\n      \"color\": \"<string>\"\n    }\n  ],\n  \"constraints\": {\n    \"min\": \"<number>\",\n    \"max\": \"<number>\",\n    \"scale\": \"<integer>\"\n  },\n  \"translations\": [\n    {\n      \"languageCode\": \"<string>\",\n      \"title\": \"<string>\",\n      \"visitorFacingTitle\": \"<string>\"\n    },\n    {\n      \"languageCode\": \"<string>\",\n      \"title\": \"<string>\",\n      \"visitorFacingTitle\": \"<string>\"\n    }\n  ]\n}",
              "options": {
